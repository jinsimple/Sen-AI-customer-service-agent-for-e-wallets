# ============================================================================
# FIN-05 — Mẫu biến môi trường cho PRODUCTION/LIVE (VPS + key thật)
# ============================================================================
# TẠO MỚI 19/08 (GĐ3) — file này KHÔNG tồn tại trước đó. Mục tiêu: bước
# deploy tay của PO thật chỉ là ĐIỀN GIÁ TRỊ, không phải đoán tên biến.
#
# 🔴 KHÔNG copy nguyên .env dev sang đây. File này liệt các biến app THẬT SỰ
# đọc (đối chiếu `src/config.py`), với giá trị PRODUCTION — khác `.env` dev
# ở tinh thần: secret KHÔNG có giá trị mặc định, thiếu là app CHẾT NGAY lúc
# khởi động (fail-fast), không âm thầm chạy với default kiểu "changeme".
#
# 🔴 KHÔNG BAO GIỜ commit file .env thật (chỉ file .example này được commit).
# 🔴 Key PRODUCTION (LLM/DashScope) KHÔNG BAO GIỜ đi qua phiên Claude nào —
#    PO thật tự điền trực tiếp trên VPS lúc deploy (chốt bảo mật GĐ3 `378828c`).

# ---- Bắt buộc, KHÔNG có mặc định — thiếu là app không khởi động được ----

# Postgres thật của stack production (không dùng SQLite — ADR-013).
DATABASE_URL=postgresql+psycopg2://<user>:<pass>@<host>:5432/<db>

# Redis thật của stack production — KHÔNG dùng fake:// (đó chỉ dành cho CI).
REDIS_URL=redis://<redis-host>:6379/0

# Ký JWT phiên đăng nhập. Sinh MỘT LẦN, KHÔNG commit, KHÔNG đổi tuỳ tiện
# (đổi = logout toàn bộ ngay lập tức):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<sinh-bang-lenh-tren>

# Mã hoá cột account_no (Fernet, AES128-CBC+HMAC). MẤT KEY = MẤT KHẢ NĂNG ĐỌC
# DỮ LIỆU CŨ ĐÃ MÃ HOÁ, không có cách khôi phục. Sinh MỘT LẦN:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=<sinh-bang-lenh-tren>

# ---- LLM — key PRODUCT thật, KHÔNG dùng chung key dev/free-quota ----
# 🔴 Bể free-quota dùng cho dev (LLM_MODEL_POOL bên dưới, key dev) HẾT HẠN
# 15/11/2026 và thuộc tài khoản dev — bản live KHÔNG được phụ thuộc bể đó
# (đã khai trong brief GĐ3). Điền base_url/key/model mà API key PRODUCT của
# PO thật THỰC SỰ có quyền gọi — không đoán, không copy nguyên bể dev.
LLM_BASE_URL=<base-url-nha-cung-cap-production>
LLM_MODEL=<model-chinh-phuc-vu-khach-production>
LLM_API_KEY=<key-production-that>

# ---- GĐ3: Bể xoay model khi cạn quota (876a240) ----
# Danh sách model, phân cách dấu phẩy, THỨ TỰ = ƯU TIÊN (phần tử đầu là model
# mặc định phục vụ khách — phải là model ĐÃ QUA cổng nhập bể an toàn, không
# phải model rẻ nhất). CHỈ NHẬN TÊN GHIM (có mốc/ngày/phiên bản cố định) —
# bí danh trôi (vd "deepseek-v4-pro" không mốc) bị TỪ CHỐI lúc khởi động
# (Luật chặn 19/08, Review tìm). Thiếu biến này = hành vi cũ (một model,
# không xoay) — KHÔNG bắt buộc phải set nếu chưa cần tính năng xoay.
LLM_MODEL_POOL=<model-mac-dinh-ghim>,<model-du-phong-1-ghim>,<model-du-phong-2-ghim>

# Trần chi tiêu token/ngày TỐI GIẢN — chặn TRƯỚC khi gọi model (khác rate
# limit: đó chặn theo TẦN SUẤT, cái này chặn theo TIỀN ĐÃ TIÊU). Để TRỐNG =
# KHÔNG giới hạn (hành vi trước khi có trần này). Đặt số thật trước khi mở
# cho khách thật — không có nó, một model bị tắt "Free quota only" phía nhà
# cung cấp (công tắc HỌ, không phải của ta) sẽ bắt đầu tính tiền IM LẶNG.
TRAN_TOKEN_LLM_MOI_NGAY=

# Ping khai bể lúc khởi động: "eager" gọi thử MỖI model trong bể ngay khi ứng
# dụng khởi động (tốn tiền thật mỗi lần khởi động = giá-ping × số-model —
# CHƯA vào usage.jsonl, xem ghi chú GĐ3 19/08, đối soát phải cộng tay); "lazy"
# = model được đánh dấu "chưa kiểm chứng", chỉ ping lần đầu được CHỌN thật.
# Mặc định dev=eager (ít lượt khởi động lại); LIVE nên cân nhắc "lazy" nếu
# container khởi động lại thường xuyên (vd crashloop) để tránh đốt hạn ngạch
# không kiểm soát được.
MODEL_POOL_PING=lazy

# ---- App ----
APP_ENV=production
CORS_ORIGINS=<domain-frontend-that>

# Trần token OUTPUT một lượt gọi model — để trống dùng mặc định SDK.
LLM_MAX_TOKENS=

# ---- Embedding (RAG) — GIỮ NGUYÊN OpenAI, đừng đổi cùng lúc với LLM_MODEL ----
# Đổi embedding = đổi VẬT kho RAG (phải nạp lại toàn bộ + đo lại Recall@4).
# Để trống EMBEDDING_BASE_URL = dùng OpenAI (mặc định).
# OPENAI_API_KEY=<key-openai-cho-embedding>
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=text-embedding-3-small

# ---- Hotline CSKH — số THẬT, không phải giá trị demo ----
HOTLINE_CSKH=<so-tong-dai-that>
