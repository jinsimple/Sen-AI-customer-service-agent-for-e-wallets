# Biến `engines` trong package.json từ CẢNH BÁO thành LỖI. Không có dòng này,
# npm chỉ in `npm warn EBADENGINE` rồi thoát 0 và cài tiếp — đo thật: dựng
# package thử với engines ">=99.0.0", npm install exit 0; thêm dòng này, exit 1.
# Đây chính là cách CI từng cài được bộ test frontend trên Node 20 rồi mới chết
# muộn ở runtime với "webidl.util.markAsUncloneable is not a function" — lỗi
# phiên bản đội lốt lỗi code.
engine-strict=true
