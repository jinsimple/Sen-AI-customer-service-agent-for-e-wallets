# ============================================================================
# .env.example — mẫu để `docker compose up` DỰNG ĐƯỢC từ một bản clone sạch.
#
#   cp .env.example .env      # rồi điền các dòng còn trống bên dưới
#   docker compose up -d --build
#
# ⚠️ KHÁC `.env.production.example` (điền tay khi deploy VPS thật, xem
# docs/DEPLOY.md) — hai file trả lời hai câu khác nhau, ĐỪNG gộp:
#   .env.example              → dựng LOCAL bằng `docker compose up`, để dev/demo/kiểm thử
#   .env.production.example   → điền tay trên VPS production, giá trị thật, không dùng ở đây
#
# Mọi giá trị mẫu dưới đây là GIẢ, chỉ để dựng được — KHÔNG dùng nguyên cho
# production. Sinh giá trị thật riêng cho từng môi trường.
# ============================================================================

# ---------------------------------------------------------------------------
# 🔴 IM LẶNG NGUY HIỂM — KHÔNG fail-fast, KHÔNG triệu chứng nào cả. Đây là
# lý do nó nguy hiểm hơn mọi biến "BẮT BUỘC" bên dưới: thiếu biến bắt buộc
# thì app CHẾT, còn thiếu dòng này thì app CHẠY BÌNH THƯỜNG — chỉ là chạy
# HỞ. [ĐO Bảo Mật + DevOps 20/08, trên ngăn xếp dựng đúng bằng .env.example
# cũ chưa có dòng này]: /openapi.json · /docs · /redoc trả HTTP 200 khi hỏi
# THẲNG backend — toàn bộ 34 route + schema API mở công khai.
# Trên VPS PHẢI đổi thành `production`. Để nguyên `development` (hoặc bỏ
# trống) thì mọi route + schema bị lộ, không một dòng log nào báo.
APP_ENV=development

# ---------------------------------------------------------------------------
# Benchmark EU/US 27/08, Phát hiện #2 — `/auth/otp/request` và
# `/resolutions/{id}/request-approval-otp` chỉ trả `otp_code` trong response
# khi biến này BẬT. MẶC ĐỊNH TẮT (bỏ trống/không khai = tắt), và app CHẾT NGAY
# lúc khởi động nếu bật cùng lúc APP_ENV=production (xem src/config.py) — một
# máy deploy quên gỡ cờ demo không được phép âm thầm lộ OTP giao dịch ra
# production. Local/demo/CI cần bật để test flow OTP mà không có kênh SMS
# thật.
OTP_DEMO_MODE=true

# ---------------------------------------------------------------------------
# BẮT BUỘC — thiếu là app CHẾT NGAY lúc khởi động (fail-fast, xem src/config.py).
# Cố ý KHÔNG có default kiểu "changeme": thiếu thì chết ồn ào, không âm thầm
# chạy sai (xem ADR-013 — fallback im lặng từng làm hệ thống tách đôi database).
# ---------------------------------------------------------------------------

# Postgres — docker-compose.yml đọc 3 biến này TRỰC TIẾP cho CẢ service
# `postgres` LẪN `backend` (backend tự ghép thành DATABASE_URL nội bộ, xem
# docker-compose.yml:59). Thiếu MỘT trong ba biến ⟹ postgres không init được
# ⟹ backend không bao giờ start (kẹt chờ `postgres: condition: service_healthy`
# mãi mãi — đây là nguyên nhân phổ biến nhất của "backend unhealthy" trên một
# bản clone sạch chưa có .env đúng).
POSTGRES_USER=fin05
POSTGRES_PASSWORD=doi-gia-tri-nay-truoc-khi-dung-that
POSTGRES_DB=fin05

# Sinh: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Sinh: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ Mã hoá at-rest chat/STK/mô tả khiếu nại. MẤT KEY = MẤT DỮ LIỆU VĨNH VIỄN,
# không có đường khôi phục. KHÔNG xoay key này sau khi đã có dữ liệu thật nếu
# chưa có script mã hoá lại.
FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# LLM — cần ÍT NHẤT MỘT trong hai đường dưới để agent trả lời được (thiếu cả
# hai thì backend vẫn healthy, nhưng lượt chat nào cũng lỗi).
# ---------------------------------------------------------------------------

# Đường 1 — OpenAI thẳng (mặc định).
OPENAI_API_KEY=sk-...

# Đường 2 — nhà cung cấp khác qua LLM_BASE_URL (vd DashScope/Qwen). Đặt
# LLM_BASE_URL thì BẮT BUỘC đặt kèm LLM_API_KEY — thiếu LLM_API_KEY trong khi
# đã đổi base_url thì app fail-fast NGAY (chặn đúng sự cố rò khoá OpenAI sang
# bên thứ ba đã xảy ra thật 17/08 — xem src/config.py::_khoa_cho_nha_cung_cap).
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=qwen3.7-plus-2026-05-26

# 🚫 CẤM TUYỆT ĐỐI — app raise RuntimeError ngay lúc import nếu thấy MỘT
# trong hai biến này được đặt (chúng đè base_url của CẢ chat lẫn embedding
# cùng lúc mà không cơ chế nào của dự án nhìn thấy). Để lại đây làm CẢNH BÁO,
# không phải để điền:
#   OPENAI_BASE_URL=
#   OPENAI_API_BASE=

# ---------------------------------------------------------------------------
# Tuỳ chọn — đã có default an toàn trong docker-compose.yml hoặc src/config.py.
# Liệt kê để biết chúng TỒN TẠI; bỏ trống/để nguyên comment vẫn dựng được.
# ---------------------------------------------------------------------------
# MODEL_POOL_PING=eager        # CHỈ nhận "eager" hoặc "lazy" — sai chính tả (vd "engaer")
#                               # làm app raise RuntimeError lúc khởi động, một nguyên nhân
#                               # "unhealthy" khác cần loại trừ khi debug
# TRIAGE_ENABLED=1
# REASONING_ENABLED=0
# FIN05_ALLOW_EGRESS=1
# HOTLINE_CSKH=1900-XXXX
#
# 🔴 [ĐO 25/08] RỖNG/BỎ TRỐNG = KHÔNG GIỚI HẠN (src/config.py) — trên một hệ
# sắp chia sẻ công khai, đây là "phơi chi tiêu không giới hạn ra Internet",
# không phải một mặc định trung tính. Đơn vị: TOKEN model CHAT nguyên
# (KHÔNG gồm embedding — khác nhà cung cấp, cộng chung ra một số vô nghĩa).
# Đọc lúc IMPORT ⟹ đổi giá trị bắt buộc RECREATE container (`docker exec -e`
# không đủ, không chạm tiến trình uvicorn đang phục vụ — cùng bẫy đã ghi ở
# TRIAGE_ENABLED trên).
# Đụng trần: KHÁCH nhận câu xin lỗi + được CHỈ SANG hotline — KHÔNG BAO GIỜ
# 500. [SỬA 26/08, sau `d749691`] TRƯỚC bản vá đó khách nhận nhầm câu "đang
# bận, nhắn lại sau ít phút" (sai — trần chỉ reset 00:00 UTC = 07:00 giờ VN,
# có thể còn hàng giờ); nay đã phân loại đúng, xem docs/DEPLOY.md mục "Trần
# chi tiêu LLM hằng ngày" cho dấu hiệu nhận biết đã chạm trần + cách verify.
#
# 🟢 [PO THẬT CHỐT 26/08, nguyên văn "5 triệu thôi bạn ơi"] GIÁ TRỊ ĐÃ QUYẾT
# cho PRODUCTION — quy đổi ra ~30-60 hội thoại 8-lượt/ngày tuỳ tỉ lệ tool
# call, xem docs/DEPLOY.md để biết vì sao và dấu hiệu nhận biết đã chạm trần.
# 🔴 VẪN ĐỂ COMMENT — KHÔNG bỏ comment ở đây (khác lời PO dặn "điền vào dòng
# này", nhưng cùng lý do đã giữ `BAO_VE_CSDL` ở dạng comment): tệp này là mẫu
# DÙNG CHUNG cho CI/dev clone/production, `cp .env.example .env` chạy được ở
# CẢ BA nơi. Bỏ comment ⟹ CI (4 job gọi golden_set/adversarial thật bằng
# OPENAI_API_KEY thật) VÀ mọi máy dev cũng nhận đúng trần 5.000.000 này —
# chưa đo được tổng token một lần chạy CI có vượt 5.000.000 hay không, và
# một trần âm thầm chặn giữa suite CI sẽ đọc như "test hỏng", không phải
# "đang tiết kiệm tiền". PRODUCTION đặt biến này TRỰC TIẾP trong `.env` thật
# trên máy Windows (không qua tệp mẫu này) — xem lệnh ở docs/DEPLOY.md.
# LLM_DAILY_TOKEN_CAP=5000000
#
# 🔴 [ĐO 25/08, sau sự cố `down -v` xoá sạch DB demo cùng ngày] RỖNG/BỎ TRỐNG
# = KHÔNG bảo vệ CSDL khỏi `docker compose down -v` — CHIỀU HỎNG LÀ CHIỀU IM
# LẶNG: quên dòng này KHÔNG báo lỗi, KHÔNG cảnh báo, hành vi giống HỆT trước
# khi có bản vá (`e5ee8cd`) — dễ tin nhầm "bản vá đã land rồi nên đang được
# bảo vệ" trong khi thật ra CHƯA BẬT.
# Bật lên (`BAO_VE_CSDL=true`): `postgres_data` thành `external`, `down -v`
# KHÔNG xoá được nó nữa (compose in "is external, skipping"). Không bật:
# `down -v` xoá TOÀN BỘ CSDL (ticket, khiếu nại, resolution, transcript
# chat) — không phục hồi được nếu chưa backup.
# 🔴 CHỈ BẬT TRÊN MÁY PRODUCTION (đúng NGĂN tên `fin05`, xem
# docker-compose.yml gần cuối để hiểu cơ chế tiền tố `-p`). Bật trên máy dev
# rồi dựng một ngăn `-p` tên khác ⟹ `up` chết ngay với
# "external volume ... not found" — ồn ào, không im lặng, và đó là hành vi
# ĐÚNG (đừng dựng ngăn lạ trên máy production).
# Verify đã có hiệu lực [ĐO 25/08, đọc thật output, không suy diễn]:
# `docker compose config` phải in DÒNG `external: true` dưới mục
# `volumes.postgres_data`. 🔴 KHÔNG có dòng `external: false` khi TẮT — compose
# ẩn hẳn khoá `external` khỏi output lúc đó (đo thật, không phải suy đoán) —
# nên phép kiểm ĐÚNG là "có thấy `external: true` không", không phải "so
# true/false".
# BAO_VE_CSDL=true
#
# [01/09] Bể model cho tính năng đổi/xoay (GĐ3, `876a240`) — THỨ TỰ QUAN
# TRỌNG, đừng để trống hay xáo trộn tuỳ ý. Phần tử ĐẦU là model được thử
# TRƯỚC — đặt một model chưa chắc còn hạn mức lên đầu là trả giá NGAY LẬP
# TỨC ở mọi lượt chat, không phải rủi ro lý thuyết.
#
# 🔴 VÌ SAO THỨ TỰ CỨU ĐƯỢC (không chỉ tiết kiệm mà còn tránh CHẾT hẳn):
# `graph.py` (~dòng 1541) chỉ XOAY sang model kế tiếp khi lỗi là DẤU HIỆU
# HẠN MỨC (403/quota). Gặp lỗi KHÔNG PHẢI hạn mức (vd 400 Bad Request) thì
# DỪNG XOAY HẲN — bỏ mặc mọi model phía SAU dù chúng còn hạn mức nguyên
# vẹn. Một model "độc" (hết hạn mức nhưng trả mã lỗi khác 403) nằm GIỮA bể
# sẽ chặn đứng toàn bộ các model đứng sau nó, kể cả khi bể còn 4/7 model
# khoẻ mạnh. Đây là gốc rễ thật của sự cố sáng 01/09 (đường chết
# 403→403→400→dừng suýt lên cả buổi quay video) — sửa THỨ TỰ là bản vá RẺ
# né được cạnh chết đó; sửa graph.py:1541 (để nó không dừng xoay trên lỗi
# non-quota) là việc gốc, còn tồn đọng, CHƯA làm (đổi mã lõi sẽ đổi băm
# `bam_ma_nguon`, hoãn tới khi không còn giữ băm cho một lượt đo/buổi quay).
#
# [ĐO 01/09, MỐC THỜI GIAN — SỐ NÀY SẼ CŨ, đừng tin mãi]: qwen3.7-max-2026-06-08
# · qwen3.7-max-2026-05-20 · qwen3.7-flash-2026-07-15 ĐÃ CẠN free tier
# ("AllocationQuota.FreeTierOnly"). qwen3.6-plus-2026-04-02 · qwen3.6-flash-2026-04-16
# · qwen3.5-flash-2026-02-23 CÒN hạn mức tại mốc đo. Ví dụ dưới đây đặt 3
# model CÒN hạn mức lên đầu — chỉ là ĐIỂM KHỞI ĐẦU có căn cứ tại 01/09,
# PHẢI đo lại trước khi tin nếu đã lâu (hạn mức nạp lại/cạn theo thời gian).
# LLM_MODEL_POOL=qwen3.6-plus-2026-04-02,qwen3.6-flash-2026-04-16,qwen3.5-flash-2026-02-23,qwen3.7-max-2026-06-08,qwen3.7-max-2026-05-20,qwen3.7-max-2026-05-17,qwen3.7-flash-2026-07-15
# LLM_MAX_TOKENS=
# JWT_ACCESS_EXPIRE_MINUTES=15
# BUILD_COMMIT=   # docker-compose.yml build.args tự đọc biến shell cùng tên lúc `--build`,
# BUILD_AT=       # KHÔNG đọc từ .env — để trống ở đây không có tác dụng, xem docs/devops/

# Chỉ cần khi bật service `cloudflared` (deploy home-server, xem docs/DEPLOY.md).
# Không set thì service đó chạy với token rỗng và không kết nối được — vô hại
# cho các service còn lại.
# CLOUDFLARE_TUNNEL_TOKEN=
# SITE_DOMAIN=localhost

# ---------------------------------------------------------------------------
# ⚠️ BỊ GHI ĐÈ khi chạy qua `docker compose up` — đặt ở đây KHÔNG có tác dụng
# cho service `backend`, vì khối `environment:` của nó trong docker-compose.yml
# (dòng ~56-113) ép cứng các giá trị dưới, bất kể .env ghi gì. Hai biến này
# chỉ thật sự cần điền khi chạy `make run` NGOÀI Docker (xem README.md).
#   DATABASE_URL  → compose tự ghép từ POSTGRES_USER/PASSWORD/DB ở trên,
#                   trỏ thẳng service `postgres` nội bộ
#   REDIS_URL     → compose ép cứng redis://redis:6379/0, trỏ service `redis`
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg2://fin05:xxx@127.0.0.1:5432/fin05   # chỉ cho `make run`
# REDIS_URL=redis://localhost:6379/0                                   # chỉ cho `make run`

# ──────────────────────────────────────────────────────────────────────────────
# Optional variables read by src/ (all have defaults in src/config.py; shown so a
# reader can see every knob). Values intentionally left empty — see config.py for
# the default and the reasoning of each one.
# ──────────────────────────────────────────────────────────────────────────────
# Agent / runtime:  AGENT_MAX_CONCURRENT, AGENT_TURN_TIMEOUT_SECONDS, CHECKPOINT_POOL_MAX
# Database pool:    DB_POOL_SIZE, DB_MAX_OVERFLOW
# API docs switch:  ENABLE_API_DOCS (off unless explicitly set to true)
# OpenAI client:    OPENAI_MODEL, OPENAI_MAX_RETRIES, OPENAI_TIMEOUT_SECONDS
# Embedding:        EMBEDDING_MODEL, EMBEDDING_BASE_URL, EMBEDDING_BATCH_SIZE
# RAG rerank:       RAG_RERANK_SERVICE_URL, RAG_RERANK_MODEL, RAG_RERANK_CANDIDATE_K,
#                   RAG_RERANK_THRESHOLD, RAG_RERANK_THRESHOLD_CSKH, RAG_RERANK_TIMEOUT_S
# Gates:            OTP_GATE_GROUP_B_ENABLED, T0_GATE_ENABLED
# Evaluation:       EVAL_JUDGE_MODEL (or JUDGE_MODEL), EVAL_SIM_MODEL, FIN05_EVAL_KEEP_RAW_REPLY
# Ledgers:          EGRESS_LEDGER_FILE, USAGE_LEDGER_FILE
# Tracing:          OTEL_EXPORTER_OTLP_ENDPOINT
# Optional LangSmith export (eval/export_langsmith_results.py only; tracing in the app stays OFF):
#                   LANGSMITH_API_KEY
